{
  "name": "slothspend",
  "productName": "SlothSpend",
  "version": "0.1.0",
  "description": "Local-first subscription audit: finds recurring charges, price creep and double charges in a bank CSV, entirely on your computer.",
  "main": "./out/main/index.js",
  "author": "Souptik Sarkar",
  "license": "MIT",
  "homepage": "https://slothspend.netlify.app/",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:webapp": "tsc --noEmit -p web/tsconfig.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:webapp",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "engine:venv": "uv venv engine/.venv --python 3.11 && uv pip install --python engine/.venv -r engine/requirements.lock -r engine/requirements-dev.txt",
    "engine:test": "engine/.venv/bin/python -m pytest engine/tests -q",
    "engine:build": "cd engine && .venv/bin/pyinstaller slothspend_engine.spec --noconfirm --clean",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "engine:smoke": "engine/.venv/bin/python engine/scripts/smoke_test.py",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "npm run typecheck:webapp && vite build --config web/vite.config.ts",
    "web:api": "cd engine && SLOTH_PUBLIC_URL=${SLOTH_PUBLIC_URL:-http://localhost:5173} SLOTH_DATA_DIR=${SLOTH_DATA_DIR:-../.sloth-web} .venv/bin/python -m app.web",
    "web:serve": "npm run web:build && cd engine && SLOTH_PUBLIC_URL=${SLOTH_PUBLIC_URL:-http://localhost:8770} SLOTH_DATA_DIR=${SLOTH_DATA_DIR:-../.sloth-web} .venv/bin/python -m app.web",
    "web:fake-gemini": "engine/.venv/bin/python engine/scripts/fake_gemini.py",
    "engine:ask-eval": "engine/.venv/bin/python engine/scripts/ask_eval.py"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
